[Unit]
Description=ridgewarden-radar, an experimental passive radar for AREDN meshes
Documentation=https://github.com/Londopy/ridgewarden-radar
After=network-online.target ridgewarden.service
Wants=network-online.target

[Service]
# its own user, in the core's group: it can read the core's local.token, not its station key
User=ridgewarden-radar
Group=ridgewarden-radar
SupplementaryGroups=ridgewarden
ExecStart=/usr/bin/ridgewarden-radar --config /etc/ridgewarden/radar.toml run
Restart=on-failure
RestartSec=10
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/ridgewarden-radar

[Install]
WantedBy=multi-user.target
